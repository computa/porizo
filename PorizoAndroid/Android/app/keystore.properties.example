# Copy to keystore.properties on the release machine and keep the real file out of Git.
storeFile=keystore.jks
storePassword=replace-with-release-store-password
keyAlias=porizo
keyPassword=replace-with-release-key-password

# Optional local/CI property. Debug and release builds also accept the
# PORIZO_GOOGLE_WEB_CLIENT_ID environment variable or -PporizoGoogleWebClientId=...
# porizoGoogleWebClientId=replace-with-google-web-client-id.apps.googleusercontent.com
